{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.9.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "pt_BR",

  "browser_specific_settings": {
    "gecko": {
      "id": "better-easy-dots@matheuspass.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["storage", "tabs", "scripting", "activeTab"],

  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://192.168.0.104/*",
    "https://sys.easydots.com.br/*",
    "https://*.acspontodigital.com.br/*",
    "https://*.easydots.com.br/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/favicon-16x16.png",
      "32": "icons/favicon-32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
    },
    "default_title": "__MSG_extensionName__"
  },

  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },

  "background": {
    "scripts": ["browser-compat.js", "i18n.js", "changelog.js", "background.js"]
  },

  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://192.168.0.104/*",
        "https://sys.easydots.com.br/*",
        "https://*.acspontodigital.com.br/*",
        "https://*.easydots.com.br/*"
      ],
      "js": [
        "browser-compat.js",
        "config.js",
        "i18n.js",
        "settings.js",
        "content.js",
        "pending-requests-impact.js"
      ],
      "css": [
        "eed-animations.css",
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "icons/easy-easy-dots.png"
      ],
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://192.168.0.104/*",
        "https://sys.easydots.com.br/*",
        "https://*.acspontodigital.com.br/*",
        "https://*.easydots.com.br/*"
      ]
    }
  ]
}
